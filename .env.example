# Server
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
# SERVER_MODE=all       # all (default) | gateway | api | worker

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=im
DB_PASSWORD=im_secret
DB_NAME=im_db
DB_SSLMODE=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-key
JWT_REFRESH_SECRET=change-me-refresh-secret-key
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# Gateway (multi-instance)
# GATEWAY_INSTANCE_ID=gw-01  # Optional: auto-generated if not set

# Logging
# LOG_LEVEL=info              # debug | info | warn | error
# LOG_FORMAT=text             # text | json

# Kafka (optional — disabled if KAFKA_BROKERS is empty)
# KAFKA_BROKERS=localhost:9092
# KAFKA_TOPIC_MESSAGES=im.messages
# KAFKA_CONSUMER_GROUP=im-worker
